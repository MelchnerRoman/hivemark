{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "cross-env HIVEMARK_DEV=1 electron .",
    "build:server": "npm run build --workspace=server && node scripts/bundleServerRuntime.mjs",
    "build:electron": "npm run build:server && electron-builder"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.hivemark.app",
    "productName": "Hivemark",
    "electronVersion": "45.2.3",
    "afterPack": "scripts/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web-out"
      },
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "build/server-runtime/node_modules",
        "to": "server/node_modules"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    }
  }
}
